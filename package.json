{
  "name": "vue-lottery-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "deploy": "npm run build && gh-pages -d dist",
    "lint:fsd": "eslint \"src/**/*.{ts,vue}\" --no-fix"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.0",
    "@vee-validate/yup": "^4.15.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.4.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.0",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "yup": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.22.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-vue": "~10.0.0",
    "gh-pages": "^6.3.0",
    "sass": "^1.89.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
