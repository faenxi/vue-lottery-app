# Скопіюйте цей файл у .env (файл .env не комітиться)
VITE_API_URL=https://dummyjson.com

# Необов'язково: час життя accessToken у хвилинах (за замовчуванням 60).
# Поставте 1, щоб швидко перевірити автоматичне оновлення токена через /auth/refresh.
# VITE_TOKEN_EXPIRES_IN_MINS=1

# Необов'язково: базовий шлях для gh-pages (за замовчуванням /vue-lottery-app/)
# VITE_BASE_PATH=/vue-lottery-app/
